    def trigger_quota_refresh(self) -> None:
        threading.Thread(target=self._fetch_quota_thread, daemon=True).start()

    def _fetch_quota_thread(self) -> None:
        with self._quota_lock:
            try:
                proc = subprocess.run(
                    ["agy", "-p", "/usage", "--output-format", "json"],
                    capture_output=True,
                    text=True,
                    timeout=15
                )
                if proc.returncode == 0:
                    data = json.loads(proc.stdout)
                    cmd_data = data.get("command", {}).get("data", {})
                    groups = cmd_data.get("groups", [])
                    if groups:
                        self.call_from_thread(self.set_quota_data, groups)
                        self._last_quota_fetch = time.time()
            except Exception:
                pass

