                full_lines.append(f"[dim]{desc}[/dim]\n")
            else:
                full_lines.append("")

            for b in g.get("buckets", []):
                b_name = b.get("name", "")
                frac = b.get("remaining_fraction", 1.0)
                reset = b.get("reset_time", "")
                bar_str, color = make_progress_bar(frac, width=42)
                r_str = format_relative_reset(reset, frac)
                r_display = f"[dim cyan]Refreshes in {r_str.replace('Refreshes in ', '')}[/dim cyan]" if "Refreshes" in r_str else "[green]Quota available[/green]"
                full_lines.append(f"  [bold white]{b_name}[/bold white]")
                full_lines.append(f"  [{color}]{bar_str}[/{color}]")
                full_lines.append(f"  {r_display}\n")

        self.query_one("#full-quota-content", Static).update("\n".join(full_lines).strip())

        # 5. Update Models Table with live quota fractions
        m_table = self.query_one("#all-models-table", DataTable)
        for m in ALL_MODELS_DATA:
            bid = m.get("bucket_id", "")
            b_info = bucket_map.get(bid, {})
            if b_info:
                frac = b_info.get("remaining_fraction", 1.0)
                pct = frac * 100.0
                status_text = f"{pct:.1f}% Available"
            else:
                status_text = "Pool Active"
            try:
                m_table.update_cell(m['id'], "col_status", status_text)
            except Exception:
                pass

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if event.data_table.id == "procs-table":
            if event.row_key and event.row_key.value:
                pid_str = event.row_key.value
                for p in self.active_processes:
                    if str(p["pid"]) == pid_str:
                        self.update_inspector(p)
                        break
        elif event.data_table.id == "all-models-table":
            if event.row_key and event.row_key.value:
                mid = event.row_key.value
                for m in ALL_MODELS_DATA:
                    if m["id"] == mid:
                        details = (
                            f"[bold white]{escape(m['name'])}[/bold white] │ Group: [cyan]{escape(m['group'])}[/cyan] │ Thinking: [yellow]{escape(m['thinking'])}[/yellow]\n"
                            f"[dim]{escape(m['description'])}[/dim]\n"
                            f"[bold green]Launch Command:[/bold green] [white]{escape(m['example'])}[/white]"
                        )
                        self.query_one("#model-inspector-content", Static).update(details)
                        break

    def update_processes(self) -> None:
        if self.is_paused:
            return

        procs = []
        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                pid = int(os.path.basename(pid_dir))
                with open(f"{pid_dir}/cmdline", "rb") as f:
                    cmd_bytes = f.read().split(b"\0")
                cmd_strs = [c.decode("utf-8", errors="replace") for c in cmd_bytes if c]
                if not cmd_strs:
                    continue
                bin_name = os.path.basename(cmd_strs[0])
                if "agy" in bin_name and "agy-top" not in cmd_strs[0]:
                    full_cmd = " ".join(cmd_strs)
                    # Extract model
                    model = "-"
                    if "--model" in cmd_strs:
                        idx = cmd_strs.index("--model")
                        if idx + 1 < len(cmd_strs):
                            model = cmd_strs[idx + 1]
                    # Extract prompt
                    prompt = "(interactive)"
                    if "-p" in cmd_strs:
                        idx = cmd_strs.index("-p")
                        if idx + 1 < len(cmd_strs):
                            prompt = cmd_strs[idx + 1].strip().replace("\n", " ")
                    elif "--prompt" in cmd_strs:
                        idx = cmd_strs.index("--prompt")
                        if idx + 1 < len(cmd_strs):
                            prompt = cmd_strs[idx + 1].strip().replace("\n", " ")
                    elif "remote-control" in full_cmd:
                        prompt = "remote-control daemon"
                        model = "daemon"

                    # Get ppid and stats from ps
                    ps_out = subprocess.run(
                        ["ps", "-p", str(pid), "-o", "ppid,%cpu,%mem,rss,etime", "--no-headers"],
                        capture_output=True, text=True
                    ).stdout.strip().split()

                    if len(ps_out) >= 5:
                        ppid = ps_out[0]
                        cpu = float(ps_out[1])
                        mem = f"{int(ps_out[3]) // 1024}M"
                        etime = ps_out[4]
                    else:
                        ppid = "-"
                        cpu = 0.0
                        mem = "-"
                        etime = "-"

                    status = "RUNNING" if cpu > 0.5 else ("DAEMON" if "remote" in full_cmd else "IDLE")

                    procs.append({
                        "pid": pid,
                        "ppid": ppid,
                        "model": model,
                        "cpu": cpu,
                        "mem": mem,
                        "etime": etime,
                        "status": status,
                        "prompt": prompt,
                        "full_cmd": full_cmd
                    })
            except Exception:
                pass

        # Sort
        if self.sort_column == "cpu":
            procs.sort(key=lambda x: x["cpu"], reverse=True)
        elif self.sort_column == "mem":
            procs.sort(key=lambda x: int(x["mem"].replace("M", "") or 0), reverse=True)
        elif self.sort_column == "pid":
            procs.sort(key=lambda x: x["pid"])
        elif self.sort_column == "time":
            procs.sort(key=lambda x: x["etime"], reverse=True)

        self.active_processes = procs
        self.update_header()

        # Render DataTable
        table = self.query_one("#procs-table", DataTable)
        current_row_key = table.cursor_row
        table.clear()

        for p in procs:
            status_styled = f"[green]{p['status']}[/green]" if p['status'] == "RUNNING" else (
                f"[cyan]{p['status']}[/cyan]" if p['status'] == "IDLE" else f"[dim]{p['status']}[/dim]"
            )
            cpu_styled = f"[bold yellow]{p['cpu']}%[/bold yellow]" if p['cpu'] > 5.0 else f"{p['cpu']}%"
            prompt_raw = p.get('prompt', '')
            prompt_clean = (prompt_raw[:50] + "...") if len(prompt_raw) > 50 else prompt_raw
            prompt_short = escape(prompt_clean)
            model_escaped = escape(str(p.get('model', '-')))

            table.add_row(
                str(p['pid']),
                str(p['ppid']),
                model_escaped,
                cpu_styled,
                p['mem'],
                p['etime'],
                status_styled,
                prompt_short,
                key=str(p['pid'])
            )

        # Update inspector if row selected
        if procs:
            idx = min(current_row_key if current_row_key is not None else 0, len(procs) - 1)
            sel = procs[idx]
            self.update_inspector(sel)
        else:
            self.query_one("#inspector-content", Static).update("[dim]No active agy processes running currently.[/dim]")

    def update_inspector(self, p: Dict[str, Any]) -> None:
        ppid = p.get("ppid", "-")
        parent_cmd = "-"
        if ppid != "-" and os.path.exists(f"/proc/{ppid}/cmdline"):
            try:
                with open(f"/proc/{ppid}/cmdline", "rb") as f:
                    parent_cmd = f.read().replace(b"\0", b" ").decode("utf-8", errors="replace").strip()
            except Exception:
                pass

        safe_parent = escape(parent_cmd[:150])
        safe_model = escape(str(p.get("model", "-")))
        raw_cmd = p.get("full_cmd", "")
        # Truncate prompt so large 60k+ prompts don't degrade UI performance
        if len(raw_cmd) > 1500:
            safe_cmd = escape(raw_cmd[:1500]) + " [dim]... (truncated)[/dim]"
        else:
            safe_cmd = escape(raw_cmd)

        details = (
            f"[bold cyan]PID {p['pid']}[/bold cyan] │ Model: [bold green]{safe_model}[/bold green] │ Parent PID: {ppid}\n"
            f"[bold white]Parent Command:[/bold white] [dim]{safe_parent}[/dim]\n"
            f"[bold white]Full Command / Prompt:[/bold white] {safe_cmd}"
        )
        try:
            self.query_one("#inspector-content", Static).update(details)
        except Exception:
            self.query_one("#inspector-content", Static).update(
                Text(f"PID {p['pid']} │ Model: {p.get('model', '-')}\nParent: {parent_cmd[:100]}\nCmd: {raw_cmd[:1000]}")
            )

    def update_tokens(self) -> None:
        if self.is_paused:
            return

        now = time.time()
        day_ago = now - 86400
        total_in = 0
        total_out = 0
        total_cache = 0
        total_steps = 0
        recent = []
        all_logs = []

        transcripts = glob.glob(os.path.expanduser("~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"))
        for path in transcripts:
            try:
                mtime = os.path.getmtime(path)
                if mtime < day_ago:
                    continue
                conv_id = path.split("/brain/")[1].split("/")[0][:8]
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        if '"input_tokens"' not in line:
                            continue
                        step = json.loads(line)
                        in_tok = step.get("input_tokens", 0)
                        out_tok = step.get("output_tokens", 0)
                        cache_tok = step.get("cache_read_tokens", 0)
                        total_in += in_tok
                        total_out += out_tok
                        total_cache += cache_tok
                        total_steps += 1

                        created = step.get("created_at", "")
                        item = {
                            "time": created,
                            "conv": conv_id,
                            "in": in_tok,
                            "out": out_tok,
                            "cache": cache_tok,
                            "total": in_tok + out_tok + cache_tok
                        }
                        recent.append(item)
                        all_logs.append(item)
            except Exception:
                pass

        # Sort recent turns
        recent.sort(key=lambda x: x["time"], reverse=True)
        self.recent_turns = recent[:5]
        self.all_turns_history = recent[:50]

        # Calculate cache hit percentage
        cache_total = total_in + total_cache
        cache_ratio = (total_cache / cache_total * 100) if cache_total > 0 else 0.0

        # Update Tokens Widget
        tok_lines = [
            f"• [bold white]Input Tokens:[/bold white]      {format_tokens(total_in):>10}  ({total_in:,})",
            f"• [bold white]Output Tokens:[/bold white]     {format_tokens(total_out):>10}  ({total_out:,})",
            f"• [bold white]Cache Read:[/bold white]        {format_tokens(total_cache):>10}  ({cache_ratio:.1f}% hit ratio)",
            f"• [bold white]Total LLM Turns:[/bold white]   {total_steps:>10}  steps today",
            f"• [bold white]Tokens Today:[/bold white]      {format_tokens(total_in + total_out + total_cache):>10}"
        ]
        self.query_one("#tokens-content", Static).update("\n".join(tok_lines))

        # Update Recent Turns Widget
        rec_lines = []
        for r in self.recent_turns:
            t_str = r["time"][11:19] if len(r["time"]) >= 19 else r["time"]
            rec_lines.append(
                f"[dim]{t_str}[/dim]  [green]In: {format_tokens(r['in'])}[/green]  "
                f"[cyan]Out: {format_tokens(r['out'])}[/cyan]  "
                f"[yellow]Cache: {format_tokens(r['cache'])}[/yellow]"
            )
        if not rec_lines:
            rec_lines.append("[dim]No recent model turns recorded today.[/dim]")
        self.query_one("#recent-content", Static).update("\n".join(rec_lines))

        # Update Tab 3 Logs Table
        logs_table = self.query_one("#logs-table", DataTable)
        logs_table.clear()
        for l in self.all_turns_history:
            t_str = l["time"].replace("T", " ")[:19]
            logs_table.add_row(
                t_str,
                f"session-{l['conv']}",
                f"{l['in']:,}",
                f"{l['out']:,}",
                f"{l['cache']:,}",
                f"{l['total']:,}"
            )

